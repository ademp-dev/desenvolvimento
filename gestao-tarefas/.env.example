# Banco PostgreSQL
DATABASE_URL="postgresql://tarefas:tarefas@localhost:5432/tarefas?schema=public"

# Auth.js — gere com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET=""
# URL pública do app (em produção, a URL do Cloud Run ou domínio próprio)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Cliente OAuth "Aplicativo da Web" criado no Google Cloud Console (tela de consentimento INTERNA)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Domínio Google Workspace autorizado (somente contas deste domínio entram)
ALLOWED_DOMAIN="ademp.org.br"

# E-mails que viram ADMIN automaticamente no primeiro login (separados por vírgula)
ADMIN_EMAILS="administrativo@ademp.org.br"

# Chave de 32 bytes em base64 para criptografar os refresh tokens do Gmail
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Client ID OAuth do projeto Apps Script do complemento do Gmail (audience do ID token).
# Pode haver mais de um, separados por vírgula.
ADDON_OAUTH_CLIENT_IDS=""

# Fuso horário de exibição
APP_TIMEZONE="America/Sao_Paulo"
